FROM node:18-alpine AS deps
WORKDIR /app
COPY package.json ./
RUN npm install --legacy-peer-deps

FROM node:18-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1

# NEXT_PUBLIC_* vars are inlined into the client bundle at build time, so they
# must arrive as build args (docker-compose `build.args`), not just as
# runtime `environment`/`env_file` values which only affect the container
# after it starts.
ARG NEXT_PUBLIC_MAPBOX_TOKEN
ARG NEXT_PUBLIC_STRAPI_URL
ARG NEXT_PUBLIC_TILESERVER_URL
ARG NEXT_PUBLIC_FORECAST_COLORMAP
ARG NEXT_PUBLIC_FORECAST_OPACITY
ARG NEXT_PUBLIC_FORECAST_MIN
ARG NEXT_PUBLIC_FORECAST_MAX
ARG NEXT_PUBLIC_STATION_CLUSTER_RADIUS
ARG NEXT_PUBLIC_SWOT_CLUSTER_RADIUS
ARG NEXT_PUBLIC_SHOW_STATION_MARKERS
ARG NEXT_PUBLIC_SWOT_METRIC_SELECTOR_ENABLED
ENV NEXT_PUBLIC_MAPBOX_TOKEN=$NEXT_PUBLIC_MAPBOX_TOKEN
ENV NEXT_PUBLIC_STRAPI_URL=$NEXT_PUBLIC_STRAPI_URL
ENV NEXT_PUBLIC_TILESERVER_URL=$NEXT_PUBLIC_TILESERVER_URL
ENV NEXT_PUBLIC_FORECAST_COLORMAP=$NEXT_PUBLIC_FORECAST_COLORMAP
ENV NEXT_PUBLIC_FORECAST_OPACITY=$NEXT_PUBLIC_FORECAST_OPACITY
ENV NEXT_PUBLIC_FORECAST_MIN=$NEXT_PUBLIC_FORECAST_MIN
ENV NEXT_PUBLIC_FORECAST_MAX=$NEXT_PUBLIC_FORECAST_MAX
ENV NEXT_PUBLIC_STATION_CLUSTER_RADIUS=$NEXT_PUBLIC_STATION_CLUSTER_RADIUS
ENV NEXT_PUBLIC_SWOT_CLUSTER_RADIUS=$NEXT_PUBLIC_SWOT_CLUSTER_RADIUS
ENV NEXT_PUBLIC_SHOW_STATION_MARKERS=$NEXT_PUBLIC_SHOW_STATION_MARKERS
ENV NEXT_PUBLIC_SWOT_METRIC_SELECTOR_ENABLED=$NEXT_PUBLIC_SWOT_METRIC_SELECTOR_ENABLED

RUN npm run build

FROM node:18-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/public ./public
EXPOSE 3000
CMD ["npm", "start"]
