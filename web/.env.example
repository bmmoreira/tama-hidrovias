NEXT_PUBLIC_MAPBOX_TOKEN=your_public_mapbox_token_here
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_INTERNAL_URL=http://localhost:1337
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Mapbox cluster radius (px) for the station points layer on the public map.
NEXT_PUBLIC_STATION_CLUSTER_RADIUS=65

# Mapbox cluster radius (px) for the SWOT gauge layer on the public map.
NEXT_PUBLIC_SWOT_CLUSTER_RADIUS=65

# Station point circles/clusters are off by default (mock data). Set "true"
# once real station data is wired up.
NEXT_PUBLIC_SHOW_STATION_MARKERS=false

# The SWOT filter drawer's "Métrica visualizada" selector (Change/std/median)
# is off by default (0/off) -- gauges and cluster aggregates always use
# Change. Set "true" to let users switch the visualized metric.
NEXT_PUBLIC_SWOT_METRIC_SELECTOR_ENABLED=false

# Mapbox cluster radius (px) for the river cross-section layer on the public map.
NEXT_PUBLIC_CROSS_SECTION_CLUSTER_RADIUS=50

# Radius (px) of an individual, unclustered cross-section circle. Bumped up
# from the old flat 4-8px dot so the value label drawn on top of it (see
# NEXT_PUBLIC_CROSS_SECTION_DEFAULT_METRIC below) is actually readable.
NEXT_PUBLIC_CROSS_SECTION_CIRCLE_RADIUS=14

# Which precomputed property colors/labels an unclustered cross-section
# circle by default: "cota_leito_maxima" (max bed elevation) or
# "cota_leito_media" (mean). Changeable per-session via the map's Filtros
# drawer -- this only sets the initial value on page load.
NEXT_PUBLIC_CROSS_SECTION_DEFAULT_METRIC=cota_leito_maxima

# Two-stop color ramp (low value -> high value) for cross-section circles.
# Defaults to the same green used by the SWOT gauge legend's positive-value
# ramp (see ForecastLegend.tsx) -- cota do leito is a plain, non-diverging
# elevation, so there's no natural negative pole to ramp toward SWOT's red.
NEXT_PUBLIC_CROSS_SECTION_COLOR_LOW=#bbf7d0
NEXT_PUBLIC_CROSS_SECTION_COLOR_HIGH=#15803d

# Simulated river-navigation camera flythrough (Tapajós, "Simular
# navegação" button in the Camadas de Previsão drawer) -- see
# riverFlythrough.ts. Camera tilt in degrees (0 = straight down).
NEXT_PUBLIC_FLYTHROUGH_PITCH=65

# "Height" above the river -- a Mapbox zoom level, not a real altitude
# (there's no true 3D camera height in a 2D vector/raster style); higher
# means lower/closer to the water.
NEXT_PUBLIC_FLYTHROUGH_ZOOM=13.5

# Total time (ms) to fly the whole Tapajós reach end to end.
NEXT_PUBLIC_FLYTHROUGH_DURATION_MS=45000

# Same idea, but for the separate Madeira flythrough demo -- its own knob,
# not derived from the Tapajós one above, since Madeira's path is ~3.5x
# longer (~1014km vs ~292km); sharing one duration meant Madeira's camera
# moved ~3.5x faster, which is what "too fast" actually was.
NEXT_PUBLIC_MADEIRA_FLYTHROUGH_DURATION_MS=150000
